                     "name": "master_root", "isActive": true},
                    {"_Pointer_": "ptr:2", "_Type_": "BuildingBlocks_WidgetCanvas",
                     "name": "canvas_power", "parent": "_PointsTo_:ptr:1", "isActive": true,
