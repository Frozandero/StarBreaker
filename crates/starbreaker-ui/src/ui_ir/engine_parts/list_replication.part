// Post-layout replication of single-template `WidgetList` children.
//
// The engine's `WidgetList` repeats its item template along its main axis
// (the power screen's `list_PowerBars` pip stack: a `ColumnReverse` list with
// one authored `base_PipListItem` block, drawn once per pip slot filling the
// column). A static render replicates the laid-out template subtree
// geometrically: floor(list_main / template_main) instances stepped along the
// main axis, growing from wherever the layout anchored the template (a
// reverse-direction list anchors it at the far end, so clones grow back
// toward the start).

/// Replicate each `WidgetList`'s single active template child to fill the
/// list's main axis. Appends cloned `UiIrNode`s with fresh ids.
fn replicate_list_template_nodes(nodes: &mut Vec<UiIrNode>) {
    const MAX_INSTANCES: usize = 64;

    let list_ids: Vec<u32> = nodes
        .iter()
        .filter(|node| {
            node.is_active
                && (node.node_type.eq_ignore_ascii_case("BuildingBlocks_WidgetList")
                    || node.node_type.eq_ignore_ascii_case("widget_list"))
        })
        .map(|node| node.id)
        .collect();
    if list_ids.is_empty() {
        return;
    }

    let mut next_id: u32 = nodes.iter().map(|n| n.id).max().unwrap_or(0).wrapping_add(1);

    for list_id in list_ids {
        let Some(list) = nodes.iter().find(|n| n.id == list_id) else {
            continue;
        };
        let list_rect = list.computed_rect.clone();
        let templates: Vec<u32> = nodes
            .iter()
            .filter(|n| n.parent_id == Some(list_id) && n.is_active)
            .map(|n| n.id)
            .collect();
        // Only single-template lists replicate; lists that already hold
        // multiple items (authored or materialised) are left alone.
        let [template_id] = templates.as_slice() else {
            continue;
        };
        let Some(template) = nodes.iter().find(|n| n.id == *template_id) else {
            continue;
        };
        let t_rect = template.computed_rect.clone();
        let vertical = list_rect.h >= list_rect.w;
        let (list_main, template_main) = if vertical {
            (list_rect.h, t_rect.h)
        } else {
            (list_rect.w, t_rect.w)
        };
        if template_main < 4.0 || list_main <= template_main {
            continue;
        }
        let total = ((list_main / template_main).floor() as usize)
            .clamp(1, MAX_INSTANCES);
        if total < 2 {
            continue;
        }
        // Grow from the template's anchored end back toward the other end.
        let template_at_end = if vertical {
            (t_rect.y + t_rect.h) - (list_rect.y + list_rect.h) > -(template_main * 0.5)
        } else {
            (t_rect.x + t_rect.w) - (list_rect.x + list_rect.w) > -(template_main * 0.5)
        };
        let step = if template_at_end { -template_main } else { template_main };

        // Collect the template subtree in parent-before-child order.
        let mut subtree: Vec<u32> = vec![*template_id];
        let mut cursor = 0usize;
        while cursor < subtree.len() {
            let parent = subtree[cursor];
            cursor += 1;
            subtree.extend(
                nodes
                    .iter()
                    .filter(|n| n.parent_id == Some(parent))
                    .map(|n| n.id),
            );
        }

        for index in 1..total {
            let offset = step * index as f32;
            let mut id_map: std::collections::HashMap<u32, u32> =
                std::collections::HashMap::with_capacity(subtree.len());
            for &src in &subtree {
                id_map.insert(src, next_id);
                next_id = next_id.wrapping_add(1);
            }
            for &src in &subtree {
                let Some(source) = nodes.iter().find(|n| n.id == src) else {
                    continue;
                };
                let mut clone = source.clone();
                clone.id = id_map[&src];
                clone.parent_id = if src == *template_id {
                    Some(list_id)
                } else {
                    source.parent_id.and_then(|p| id_map.get(&p).copied())
                };
                clone.children = source
                    .children
                    .iter()
                    .filter_map(|c| id_map.get(c).copied())
                    .collect();
                if vertical {
                    clone.computed_rect.y += offset;
                } else {
                    clone.computed_rect.x += offset;
                }
                nodes.push(clone);
            }
        }
    }
}
